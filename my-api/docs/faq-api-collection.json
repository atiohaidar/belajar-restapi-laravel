      "item": [
        {
          "name": "Get All FAQs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/faqs",
              "host": ["{{base_url}}"],
              "path": ["api", "faqs"],
              "query": [
                {
                  "key": "category",
                  "value": "general",
                  "description": "Filter FAQs by category (optional)",
                  "disabled": true
                }
              ]
            },
            "description": "Returns a list of all published FAQs. If authenticated as admin or manager, also returns unpublished FAQs."
          },
          "response": [
            {
              "name": "Success Response (Public)",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/faqs"
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n    \"status\": \"success\",\n    \"data\": [\n        {\n            \"id\": 1,\n            \"question\": \"What is Laravel?\",\n            \"answer\": \"Laravel is a free, open-source PHP web framework intended for web application development.\",\n            \"is_published\": true,\n            \"order\": 1,\n            \"category\": \"general\",\n            \"created_by\": 1,\n            \"created_at\": \"2025-04-16T14:25:32.000000Z\",\n            \"updated_at\": \"2025-04-16T14:25:32.000000Z\"\n        },\n        {\n            \"id\": 2,\n            \"question\": \"How to install Laravel?\",\n            \"answer\": \"You can install Laravel using Composer by running: composer create-project laravel/laravel example-app\",\n            \"is_published\": true,\n            \"order\": 2,\n            \"category\": \"installation\",\n            \"created_by\": 1,\n            \"created_at\": \"2025-04-16T14:26:10.000000Z\",\n            \"updated_at\": \"2025-04-16T14:26:10.000000Z\"\n        }\n    ]\n}"
            }
          ]
        },
        {
